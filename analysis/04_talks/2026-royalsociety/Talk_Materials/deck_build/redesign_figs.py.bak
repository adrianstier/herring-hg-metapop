#!/usr/bin/env python3
"""
Redesigned figures for slides 8, 9, 10 of the Royal Society herring deck.

Old versions were data-faithful but visually weak:
  S8 was a spaghetti slope chart, S9 a noisy 65-yr time series, S10 a busy
  two-panel area+pct chart. New versions land each slide's punchline:
    S8 — diverging-bar showing per-section growth change, sorted, magnitude up front
    S9 — before/after epoch bars + small inset time series for context
    S10 — now concept D: HG biomass vs the marine-mammal field (two oceans)
    S10b — predator field recovered + the talk-safe ≈29%-of-stock pressure
           (the old "≈239% of spawn" framing was REMOVED as misleading —
           that was demand ÷ the DFO spawn INDEX, not the standing stock)

Style matches the baked deck chrome: dark bg #0e0e0e, ink #f0eee9, rust accent,
track-color contract (eco=kelp, cultural=plum, economic=rust, governance=marine,
window=amber). Output: 3840×2160 PNGs that go straight through the bake_chrome
pipeline in preprocess_figures.py.
"""
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import matplotlib.gridspec as gridspec
from matplotlib.ticker import FuncFormatter
import numpy as np
from pathlib import Path
from matplotlib import font_manager as fm
from matplotlib import rcParams

# Portable repo root derived from this script's location:
# <repo>/talk-usuk-forum-2026/Talk_Materials/deck_build/redesign_figs.py
REPO = Path(__file__).resolve().parents[3]
DIAG = REPO / "Output" / "diagnostics"
PRED = REPO / "Data" / "processed" / "predators"
OUT = REPO / "talk-usuk-forum-2026" / "Talk_Materials" / "deck_assets" / "_originals"
OUT.mkdir(parents=True, exist_ok=True)

# Deck palette
BG = "#0e0e0e"
INK = "#f0eee9"
INK_SOFT = "#a8a59f"
RUST = "#d9714f"
MARINE = "#6e9bc4"
KELP = "#8aa074"
PLUM = "#b685a8"
AMBER = "#cfa055"
GRID = "#2a2825"

# Fonts: portable — Liberation/DejaVu on the Linux sandbox, else Georgia/
# Courier on macOS. Georgia is the deck HEAD font (build_pptx_native.js) so
# the baked chrome stays visually consistent on either platform.
def _pick(*cands):
    for c in cands:
        if Path(c).is_file():
            return c
    return None

_LIB = "/usr/share/fonts/truetype/liberation"
_MAC = "/System/Library/Fonts/Supplemental"
SERIF        = _pick(f"{_LIB}/LiberationSerif-Regular.ttf", f"{_MAC}/Georgia.ttf")
SERIF_BOLD   = _pick(f"{_LIB}/LiberationSerif-Bold.ttf",    f"{_MAC}/Georgia Bold.ttf")
SERIF_ITALIC = _pick(f"{_LIB}/LiberationSerif-Italic.ttf",  f"{_MAC}/Georgia Italic.ttf")
MONO         = _pick("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
                      f"{_MAC}/Courier New.ttf")
for p in [SERIF, SERIF_BOLD, SERIF_ITALIC, MONO]:
    if p:
        fm.fontManager.addfont(p)
rcParams["font.family"] = "Georgia" if (SERIF and "Georgia" in SERIF) else "Liberation Serif"
rcParams["text.color"] = INK
rcParams["axes.labelcolor"] = INK
rcParams["xtick.color"] = INK
rcParams["ytick.color"] = INK
rcParams["axes.edgecolor"] = INK_SOFT
rcParams["axes.facecolor"] = BG
rcParams["figure.facecolor"] = BG
rcParams["savefig.facecolor"] = BG
rcParams["axes.grid"] = False
rcParams["font.size"] = 14

# Target render: figures get baked with chrome — content zone is 3840×1500.
# Render figures at 3840 wide, 1500 tall, then the bake adds top/bottom chrome.
W_IN = 19.2     # 3840/200 → 200 dpi
H_IN = 7.5      # 1500/200
DPI = 200


def s8_diverging_growth():
    """S8 — per-section change in mean realized growth, post-1994 vs historical.
    ALL-11 m1_stier_11 view (companion CSV, the decided source —
    numbers_provenance.md / slide_asset_map): headline = "9 of 11 declined"
    (post_growth_median < hist_growth_median). Sparse-sensitivity sections
    (Tasu Sound, Naden Harbour) shown hatched + "(sparse)", never hidden.
    Diverging bars sorted by the change; headline parked in clear space."""
    j = pd.read_csv(DIAG / "stier2020_updated_companion_growth_change.csv")
    j["delta"] = j["post_growth_median"] - j["hist_growth_median"]
    j["sparse"] = j["reporting"].str.contains("sparse", case=False, na=False)
    j["label"] = np.where(j["sparse"], j["site_name"] + "  (sparse)", j["site_name"])
    j = j.sort_values("delta", ascending=True).reset_index(drop=True)
    n_dec = int((j["delta"] < 0).sum())
    n_tot = len(j)

    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    fig.subplots_adjust(left=0.255, right=0.965, top=0.95, bottom=0.135)

    y = np.arange(n_tot)
    for i, row in j.iterrows():
        v = row["delta"]
        c = RUST if v < 0 else KELP
        ax.barh(i, v, color=(BG if row["sparse"] else c), height=0.66,
                edgecolor=c, linewidth=2.2,
                hatch=("////" if row["sparse"] else None), zorder=3)
        x = v + (0.004 if v >= 0 else -0.004)
        ax.text(x, i, f"{v:+.2f}", color=INK, ha=("left" if v >= 0 else "right"),
                va="center", fontsize=19, fontweight="bold")

    ax.axvline(0, color=AMBER, lw=2.2, alpha=0.8, zorder=2)
    ax.text(0, n_tot - 0.35, "  no change", color=AMBER, fontsize=15,
            ha="left", va="center", style="italic")

    ax.set_yticks(y)
    ax.set_yticklabels(j["label"], fontsize=18, color=INK)
    ax.set_xlabel("Change in mean realized growth rate  (post-1994 − historical)",
                  fontsize=19, color=INK_SOFT, labelpad=14)
    xpad = max(abs(j["delta"].min()), abs(j["delta"].max())) * 0.35
    ax.set_xlim(j["delta"].min() - xpad, j["delta"].max() + xpad * 1.6)
    ax.tick_params(axis="x", labelsize=15)
    ax.tick_params(axis="y", labelsize=18, pad=8)
    for spine in ("top", "right", "left"):
        ax.spines[spine].set_visible(False)
    ax.spines["bottom"].set_color(INK_SOFT)

    # headline parked in the empty positive-x / low-y quadrant (only the two
    # risers sit on the positive side, both at the very top) — no collision
    ax.text(0.985, 0.30, f"{n_dec} of {n_tot}", transform=ax.transAxes,
            ha="right", va="center", fontsize=72, fontweight="bold",
            color=KELP, style="italic")
    ax.text(0.985, 0.17, "sections declined", transform=ax.transAxes,
            ha="right", va="center", fontsize=24, color=INK, style="italic")
    ax.text(0.985, 0.10, "Port Louis & Tasu Sound the only risers",
            transform=ax.transAxes, ha="right", va="center",
            fontsize=15, color=INK_SOFT, style="italic")

    fig.savefig(OUT / "08_realized_growth.png", dpi=DPI,
                bbox_inches=None, pad_inches=0)
    plt.close(fig)
    print("wrote 08_realized_growth.png")


def s9_portfolio_before_after():
    """S9 — real-data subpopulation synchrony, 10-yr rolling window
    (deck_s09_synchrony_rolling.csv). The measured series carries it: a
    labelled y-axis, the 1994 closure marked, pre/post means shown, and the
    rise stated. The async->sync animation slide (S9b) follows as the
    mechanism cartoon."""
    df = pd.read_csv(DIAG / "deck_s09_synchrony_rolling.csv")
    df["year"] = df["window_mid"]
    pre = df[df["year"] < 1994]["synchrony"].mean()
    post = df[df["year"] >= 1994]["synchrony"].mean()
    pct_rise = 100 * (post - pre) / pre
    ymax = df["synchrony"].max() * 1.22

    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    fig.subplots_adjust(left=0.085, right=0.965, top=0.93, bottom=0.135)

    ax.fill_between(df["year"], 0, df["synchrony"], color=KELP, alpha=0.14,
                    linewidth=0)
    ax.plot(df["year"], df["synchrony"], color=KELP, lw=3.6, zorder=5)

    # 1994 roe-fishery closure
    ax.axvline(1994, color=AMBER, lw=2.2, ls=(0, (6, 4)), alpha=0.9, zorder=4)
    ax.scatter([1994], [ymax * 0.99], marker="*", s=820, color=AMBER,
               zorder=6, clip_on=False)
    ax.text(1994, ymax * 0.93, "Roe fishery\nclosed 1994", color=AMBER,
            fontsize=22, fontweight="bold", ha="center", va="top",
            linespacing=1.0)

    # pre / post mean reference segments
    x0, x1 = df["year"].min(), df["year"].max()
    ax.plot([x0, 1994], [pre, pre], color=INK_SOFT, lw=1.8, ls=":", zorder=3)
    ax.plot([1994, x1], [post, post], color=KELP, lw=1.8, ls=":", zorder=3)
    ax.text(x0 + 1, pre, f" pre-1994 mean  {pre:.2f}", color=INK_SOFT,
            fontsize=17, ha="left", va="bottom", style="italic")
    ax.text(x1 - 1, post, f"post-1994 mean  {post:.2f} ", color=KELP,
            fontsize=17, ha="right", va="bottom", style="italic")

    # headline in the empty upper-left (synchrony is low early on)
    ax.text(x0 + 1.5, ymax * 0.80, f"+{pct_rise:.0f}%", color=KELP,
            fontsize=68, fontweight="bold", ha="left", va="center",
            style="italic")
    ax.text(x0 + 1.5, ymax * 0.66, "subpopulations\nsynchronised",
            color=INK, fontsize=22, ha="left", va="center", style="italic",
            linespacing=1.0)

    ax.set_xlim(x0, x1)
    ax.set_ylim(0, ymax)
    ax.set_ylabel("Subpopulation synchrony  (10-yr rolling window)",
                  color=INK_SOFT, fontsize=19, labelpad=12)
    ax.tick_params(labelsize=16)
    ax.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.55)
    for s in ("top", "right"):
        ax.spines[s].set_visible(False)
    ax.spines["left"].set_color(INK_SOFT)
    ax.spines["bottom"].set_color(INK_SOFT)

    fig.savefig(OUT / "09_synchrony.png", dpi=DPI,
                bbox_inches=None, pad_inches=0)
    plt.close(fig)
    print("wrote 09_synchrony.png")


def s10_predator_demand():
    """S10 — concept D: HG herring biomass (rust, left) vs the marine-mammal
    field that eats it (blue, right), 1950–2025. The 1960s collapse rebounds
    with mammals whaling-depleted (~0.2 kt); the post-1994 non-recovery sits
    under a recovered mammal field (~5.6 kt). UNFRAMED content figure — the
    chrome bake (preprocess_figures.py JOBS) adds the title/takeaway."""
    cg = pd.read_csv(PRED / "hg_predator_consumption_by_group_year.csv")
    mam = cg[cg["group"] == "mammals"].sort_values("year")
    b = pd.read_csv(DIAG / "m1_stier_11_total_biomass_by_year.csv")
    b = b[b["report_set"] == "focal_9"].sort_values("year")

    X0, X1 = 1950, 2025
    bm = b[(b["year"] >= X0) & (b["year"] <= X1)]
    mm = mam[(mam["year"] >= X0) & (mam["year"] <= X1)]
    C68 = float(np.interp(1968, mam["year"], mam["C_kt"]))
    C20 = float(mm[mm["year"] <= 2020]["C_kt"].iloc[-1])

    # mammal demand is genuinely spiky year-to-year — interpolate the early
    # 5-yr-spaced rows to annual, then a 5-yr centered running mean so the
    # TREND reads (raw kept faint behind it — nothing hidden).
    myr = np.arange(X0, X1 + 1)
    mraw = np.interp(myr, mm["year"], mm["C_kt"])
    msm = pd.Series(mraw).rolling(5, center=True, min_periods=1).mean().values

    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    fig.subplots_adjust(left=0.072, right=0.912, top=0.93, bottom=0.135)
    ax2 = ax.twinx()

    # mammal demand — blue, right axis: faint raw + smoothed line + fill
    ax2.plot(myr, mraw, color=MARINE, lw=1.1, alpha=0.28, zorder=1)
    ax2.fill_between(myr, 0, msm, color=MARINE, alpha=0.20, lw=0, zorder=1)
    ax2.plot(myr, msm, color=MARINE, lw=3.4, zorder=2)
    # herring biomass — rust, left axis
    ax.plot(bm["year"], bm["median"], color=RUST, lw=3.6, zorder=5)

    for x in (1968, 1994):
        ax.axvline(x, color=AMBER, lw=2.2, ls=(0, (6, 4)), alpha=0.85, zorder=3)
    ax.text(1969, 116000,
            f"1968 collapse\nmammal demand ≈{C68:.1f} kt\nherring rebounds in ~5 yr",
            color=AMBER, fontsize=22, fontweight="bold", va="top",
            linespacing=1.18)
    ax.text(1996, 116000,
            f"1994 collapse\nmammal demand rising to ≈{C20:.1f} kt\nno recovery, 30+ yr",
            color=AMBER, fontsize=22, fontweight="bold", va="top",
            linespacing=1.18)
    # pre-1920 caveat moved to just above the x-axis (split two lines)
    ax.text(1951, 2200,
            "Before commercial whaling (pre-1920) mammals took ~17 kt/yr;\n"
            "whaling left the 1960s ocean nearly predator-free.",
            color=INK_SOFT, fontsize=15, style="italic", va="bottom",
            linespacing=1.1)
    # thin gold arrow at ~1990 crossover where mammal demand surpasses ~1 kt/yr
    ax.annotate("", xy=(1990, 13000), xytext=(1990, 5000),
                arrowprops=dict(arrowstyle="-|>", color=AMBER, lw=1.8,
                                mutation_scale=16))

    ax.set_xlim(X0, X1)
    ax.set_ylim(0, 124000)
    ax.set_ylabel("HG herring biomass  (m1_stier_11)", color=RUST,
                  fontsize=18, labelpad=10)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{v/1000:.0f} kt"))
    ax.tick_params(labelsize=15)
    ax.tick_params(axis="y", colors=RUST)
    ax.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.4)
    for s in ("top",):
        ax.spines[s].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_color(RUST)
    ax.spines["bottom"].set_color(INK_SOFT)

    ax2.set_ylim(0, 6.6)
    ax2.set_ylabel("marine-mammal demand on herring  (kt yr$^{-1}$)",
                   color=MARINE, fontsize=18, labelpad=14, rotation=270,
                   va="bottom")
    ax2.tick_params(colors=MARINE, labelsize=15)
    for s in ("top",):
        ax2.spines[s].set_visible(False)
    ax2.spines["left"].set_visible(False)
    ax2.spines["right"].set_color(MARINE)

    # No in-plot legend: the axes are the legend (rust left = herring
    # biomass, blue right = marine-mammal demand). Avoids colliding with
    # the 1994 callout in the upper-right.

    fig.savefig(OUT / "10_predators.png", dpi=DPI,
                bbox_inches=None, pad_inches=0)
    plt.close(fig)
    print("wrote 10_predators.png")


def s10b_predator_pit():
    """S10b — THE PREDATOR PIT. A different process now sets the ceiling.
    Left: audited TOTAL predator demand on herring rose from a whaling-
    depleted mid-century (~0 kt) to a large sustained draw now, while
    fishing was removed (~0-t HG catch since 2002). The sourced pressure
    is the talk-safe brief's claim: ≈15.5 kt/yr taken vs an ≈47 kt
    m1_stier_11 stock — ≈29% removal analogue (predator_talk_brief.md).
    NOTE: deliberately NOT plotted against the DFO spawn INDEX (that gave
    the misleading >100% "239% of spawn" ratio — a survey index, not the
    standing stock) and NOT recomputed against the deck's focal_9 series
    (unvetted); the brief's vetted figure is shown as a sourced annotation.
    Right: who eats it now — humpback + Steller sea lion (the recovered
    marine mammals) lead (SB2 audited species means). UNFRAMED content
    figure (chrome bake adds title/takeaway). GUARDRAIL: audited demand =
    a measured ecological PRESSURE, NOT a fitted m1_stier_11 mortality
    coefficient; consumptive lock-in shown at hypothesis strength."""
    pi = pd.read_csv(PRED / "hg_predation_pressure_index_audited.csv")
    for c in ("year", "C_total_kt"):
        pi[c] = pd.to_numeric(pi[c], errors="coerce")
    pi = pi[(pi["year"] >= 1951) & (pi["year"] <= 2024)].sort_values("year")

    yr = np.arange(1951, 2025)                            # 1951–2024 solid
    dem = pd.Series(np.interp(yr, pi["year"], pi["C_total_kt"])) \
            .rolling(5, center=True, min_periods=1).mean().values

    sp = pd.read_csv(PRED / "hg_predator_consumption_by_species_recent.csv")
    sp["kt"] = sp["mean_consumption_t"] / 1000.0
    sp = sp.sort_values("kt", ascending=True).tail(8)
    gcol = {"mammals": MARINE, "fish": KELP, "salmon": AMBER, "birds": PLUM}

    fig = plt.figure(figsize=(W_IN, H_IN), dpi=DPI)
    gs = gridspec.GridSpec(1, 2, width_ratios=[1.62, 1.0], wspace=0.30,
                           left=0.075, right=0.945, top=0.92, bottom=0.135)
    axL = fig.add_subplot(gs[0])
    axR = fig.add_subplot(gs[1])

    # ── LEFT: the predator field recovered (audited demand, smoothed) ──
    axL.fill_between(yr, 0, dem, color=MARINE, alpha=0.16, lw=0, zorder=1)
    axL.plot(yr, dem, color=MARINE, lw=3.8, zorder=5)
    # (no in-panel series label — single series; the y-axis already names it)

    # fishing removed (closure → ~0-t HG catch since 2002) — label in the
    # clear post-1994 top band, right of the line
    axL.axvline(1994, color=AMBER, lw=2.2, ls=(0, (6, 4)), alpha=0.9,
                zorder=3)
    # "Fishing removed" label stays well above the rising line (top of panel)
    axL.text(1996, 27.6, "Fishing removed\nclosed 1994 · ~0-t HG since 2002",
             color=AMBER, fontsize=16, fontweight="bold", ha="left",
             va="top", linespacing=1.15)

    # headline — the talk-safe sourced pressure, parked upper-left where
    # demand is ~0 pre-1985 (no collision with the rising curve)
    axL.text(1953, 21.5, "≈29%", color=MARINE, fontsize=66,
             fontweight="bold", ha="left", va="center", style="italic")
    axL.text(1954, 15.0, "of the standing herring stock\ntaken by "
             "predators every year", color=INK, fontsize=18, ha="left",
             va="center", style="italic", linespacing=1.12)
    axL.text(1954, 10.2, "2015–24  ·  ≈15.5 kt/yr from a ≈47 kt stock",
             color=INK_SOFT, fontsize=14, ha="left", va="center",
             style="italic")

    axL.set_xlim(1951, 2024)
    axL.set_ylim(0, 28)
    axL.set_ylabel("predator demand on herring  (kt · yr$^{-1}$)",
                   color=INK_SOFT, fontsize=18, labelpad=10)
    axL.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{v:.0f} kt"))
    axL.tick_params(labelsize=15)
    axL.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.4)
    for s in ("top", "right"):
        axL.spines[s].set_visible(False)
    axL.spines["left"].set_color(INK_SOFT)
    axL.spines["bottom"].set_color(INK_SOFT)

    # ── RIGHT: who eats it now (recovered marine-mammal field) ─────────
    # No legend (it collided with the bottom bar and showed an empty
    # Salmon class): the title says it, mammals=blue read directly.
    y = np.arange(len(sp))
    cols = [gcol.get(g, INK_SOFT) for g in sp["group"]]
    axR.barh(y, sp["kt"], color=cols, height=0.70, edgecolor="none",
             zorder=3)
    for i, v in enumerate(sp["kt"]):
        axR.text(v + 0.12, i, f"{v:.2f}", color=INK, va="center",
                 ha="left", fontsize=15, fontweight="bold")
    axR.set_yticks(y)
    # species names bumped from 15pt to 20pt
    axR.set_yticklabels(sp["species"], fontsize=20, color=INK)
    axR.set_xlim(0, sp["kt"].max() * 1.26)
    axR.set_xlabel("mean recent demand  (kt · yr$^{-1}$)", color=INK_SOFT,
                   fontsize=16, labelpad=10)
    # right-panel header promoted from italic mid-grey 17pt to white 18pt bold
    axR.set_title("who eats it now — humpback leads; recovered\nmarine "
                  "mammals (blue) now rival the groundfish (green)",
                  color="white", fontsize=18, fontweight="bold", pad=12,
                  linespacing=1.1)
    axR.tick_params(axis="x", labelsize=13)
    axR.tick_params(axis="y", labelsize=20, pad=6)
    for s in ("top", "right"):
        axR.spines[s].set_visible(False)
    axR.spines["left"].set_color(BG)
    axR.spines["bottom"].set_color(INK_SOFT)

    fig.savefig(OUT / "10b_predator_pit.png", dpi=DPI, bbox_inches=None,
                pad_inches=0)
    plt.close(fig)
    print("wrote 10b_predator_pit.png")


def s12_four_clocks_timeline():
    """S12 — four layers on one time axis, each with a tipping mark. Management
    window shaded amber. Co-governance rises while three layers fall — the
    visual carries the 'gap is the management window' thesis without prose."""
    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    # wider left+right margins so row labels and right-side notes are never
    # clipped at the figure boundary (bbox_inches=None keeps 3840×1500 exact).
    # left 0.265 → ~1018 px for labels; right 0.70 → ~1152 px for notes.
    fig.subplots_adjust(left=0.265, right=0.70, top=0.92, bottom=0.16)

    # x-axis: years
    yr_lo, yr_hi = 1980, 2026
    ax.set_xlim(yr_lo, yr_hi)
    # 4 vertical tracks
    tracks = [
        dict(label="Cultural service — k'aaw", color=PLUM, y=4.0,
             tip_year=1990, motion="falls", note="spawn-area contraction · post-2002 functional closure"),
        dict(label="Ecological structure",      color=KELP, y=3.0,
             tip_year=1993, motion="falls", note="subpopulation synchrony rises >60%"),
        dict(label="Economic value (HG 2E roe)", color=RUST, y=2.0,
             tip_year=2005, motion="falls", note="landed value peaks 1980s; declines through 1990s"),
        dict(label="Co-governance",              color=MARINE, y=1.0,
             tip_year=1985, motion="rises", note="Athlii Gwaii 1985 → AMB → 2024 Rebuilding Plan"),
    ]
    # management-window band (amber): from earliest fall (~1990) through latest fall (~2005)
    ax.axvspan(1990, 2005, color=AMBER, alpha=0.10, zorder=0)
    ax.text(1997.5, 4.85, "management window",
            color=AMBER, fontsize=18, ha="center", va="center",
            style="italic", fontweight="bold")
    ax.annotate("", xy=(2005, 4.7), xytext=(1990, 4.7),
                arrowprops=dict(arrowstyle="|-|", color=AMBER, lw=2.2))

    for t in tracks:
        y = t["y"]
        # track baseline
        ax.hlines(y, yr_lo, yr_hi, colors=t["color"], linestyles=":",
                  linewidth=2.0, alpha=0.35)
        # tipping marker — arrows now stay tight to their own track to avoid
        # colliding with neighboring labels
        if t["motion"] == "falls":
            ax.annotate("", xy=(t["tip_year"], y - 0.20), xytext=(t["tip_year"], y + 0.20),
                        arrowprops=dict(arrowstyle="-|>", color=t["color"], lw=4,
                                        mutation_scale=28))
            ax.scatter([t["tip_year"]], [y + 0.20], s=160, color=t["color"], zorder=5)
            # year label tucked to the right of the dot (in-track, won't collide)
            ax.text(t["tip_year"] + 0.6, y + 0.20, f"~{t['tip_year']}",
                    color=t["color"], fontsize=15, ha="left", va="center",
                    fontfamily="DejaVu Sans Mono", clip_on=False, fontweight="bold")
        else:
            # rising arrow at a shallower angle, kept within the track
            ax.annotate("", xy=(t["tip_year"] + 18, y + 0.25), xytext=(t["tip_year"], y - 0.18),
                        arrowprops=dict(arrowstyle="-|>", color=t["color"], lw=4,
                                        mutation_scale=28))
            ax.scatter([t["tip_year"]], [y - 0.18], s=160, color=t["color"], zorder=5)
            ax.text(t["tip_year"] - 0.6, y - 0.18, f"{t['tip_year']}+",
                    color=t["color"], fontsize=15, ha="right", va="center",
                    fontfamily="DejaVu Sans Mono", clip_on=False, fontweight="bold")
        # left-side label — fontsize 20 (was 22) so the longest label fits
        ax.text(yr_lo - 0.5, y, t["label"], color=t["color"],
                fontsize=20, fontweight="bold", ha="right", va="center",
                clip_on=False)
        # right-side note — fontsize 13 (was 14) so the longest note fits
        ax.text(yr_hi + 0.5, y, t["note"], color=INK_SOFT,
                fontsize=13, ha="left", va="center", style="italic",
                clip_on=False)

    ax.set_ylim(0.2, 5.4)
    ax.set_yticks([])
    ax.set_xticks([1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025])
    ax.tick_params(labelsize=15)
    for s in ("top", "left", "right"):
        ax.spines[s].set_visible(False)
    ax.spines["bottom"].set_color(INK_SOFT)
    ax.xaxis.set_tick_params(colors=INK_SOFT)

    fig.savefig(OUT / "12_decoupling.png", dpi=DPI,
                bbox_inches=None, pad_inches=0)
    plt.close(fig)
    print("wrote 12_decoupling.png")


def s5_two_collapses():
    """S5 — REAL m1_stier_11 estimated total HG biomass, focal-9, 1951–2025.
    One rust line + one 80% CI ribbon (a single halo). The two fishery
    closures are the highlight: amber dashed verticals, a star marker, and
    large amber labels so they read from the back row."""
    df = pd.read_csv(DIAG / "m1_stier_11_total_biomass_by_year.csv")
    bm = df[df["report_set"] == "focal_9"].sort_values("year")
    yr = bm["year"].values
    # units-consistent reference: the SAME m1 series, pre-collapse mean.
    # (NOT the DFO 6.45 kt LRP — that is spawning biomass from DFO SCA, a
    #  different quantity; it stays on the B-DFO slide.)
    hist_ref = bm[bm["year"].between(1951, 1965)]["median"].mean()
    # Cap the axis just above the 1950s peak. The 80% CI balloons after
    # ~2023 (terminal years weakly constrained) and clips off-chart — that
    # clipping is itself the honest signal that the recent rise is
    # uncertainty, not a measured recovery.
    ymax = 115000.0

    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    fig.subplots_adjust(left=0.105, right=0.965, top=0.93, bottom=0.135)

    ax.fill_between(yr, bm["lo80"], bm["hi80"], color=RUST, alpha=0.16,
                    linewidth=0)
    ax.plot(yr, bm["median"], color=RUST, lw=3.4, zorder=5)

    # historic reference line (recovery would mean returning to this band)
    ax.axhline(hist_ref, color=INK_SOFT, lw=1.6, ls=(0, (5, 4)), alpha=0.85,
               zorder=3)
    ax.text(yr.min() + 0.5, hist_ref + ymax * 0.038,
            f"historic level  ·  m1_stier_11 1951–65 mean ≈ {hist_ref/1000:.0f} kt",
            color=INK_SOFT, fontsize=14, style="italic", ha="left",
            va="bottom")

    CREAM = "#F8F1E1"
    closures = [(1968, "Reduction fishery\nclosed ~1968", "rebounded in ~5 yr"),
                (1994, "Roe fishery\nclosed 1994", "still below historic, 30+ yr")]
    for cx, lab, sub in closures:
        ax.axvline(cx, color=AMBER, lw=2.4, ls=(0, (6, 4)), alpha=0.92,
                   zorder=4)
        ax.scatter([cx], [ymax * 0.99], marker="*", s=900, color=AMBER,
                   zorder=6, clip_on=False)
        ax.text(cx, ymax * 0.935, lab, color=AMBER, fontsize=24,
                fontweight="bold", ha="center", va="top", linespacing=1.0)
        # PUNCHLINE: cream, bold, ~22pt — promoted from INK_SOFT 16pt
        ax.text(cx, ymax * 0.70, sub, color=CREAM, fontsize=22,
                fontweight="bold", ha="center", va="top")

    # terminal-year honesty note: demoted to ~14pt caveat (was 14pt italic)
    ax.annotate("recent years weakly constrained —\n80% CI runs off-chart "
                "(90% far higher)", xy=(2024.3, ymax * 0.985),
                xytext=(2001, ymax * 0.50), color=INK_SOFT, fontsize=14,
                style="italic", ha="left", va="center", linespacing=1.1,
                arrowprops=dict(arrowstyle="-|>", color=INK_SOFT, lw=1.6))

    ax.set_xlim(yr.min(), yr.max())
    ax.set_ylim(0, ymax)
    ax.set_ylabel("Estimated biomass (tonnes)", color=INK_SOFT, fontsize=20,
                  labelpad=12)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{int(v):,}"))
    ax.tick_params(labelsize=16)
    ax.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.55)
    for s in ("top", "right"):
        ax.spines[s].set_visible(False)
    ax.spines["left"].set_color(INK_SOFT)
    ax.spines["bottom"].set_color(INK_SOFT)

    fig.savefig(OUT / "05_two_collapses.png", dpi=DPI, bbox_inches=None,
                pad_inches=0)
    plt.close(fig)
    print("wrote 05_two_collapses.png")


def s6_pdo_recovery():
    """S6 — REWORKED. The point is no longer the abstract PDO regression
    slope; it is that ocean productivity is real but NOT the barrier to
    recovery. Two stacked panels share a year axis: (top) the PDO index,
    cool/productive vs warm, with the 2014–16 Blob marked; (bottom) herring
    biomass with the two closures. The 1960s collapse rode favourable cool
    years back; after 1994, repeated cool/productive years — and the Blob
    came and went — brought no recovery. Necessary, not sufficient."""
    d = pd.read_csv(DIAG / "pdo_climate_yearly.csv").sort_values("year")
    d = d[d["year"] <= 2025]
    # Use the SAME focal_9 m1 series as S5 (the prior all_11
    # total_biomass_median in pdo_climate_yearly read ~87% of the historic
    # peak by 2025 — a false "recovered" signal driven by the unconstrained
    # terminal years). Bring median + 80% CI over by year.
    _mb = pd.read_csv(DIAG / "m1_stier_11_total_biomass_by_year.csv")
    _mb = (_mb[_mb["report_set"] == "focal_9"]
           [["year", "median", "lo80", "hi80"]]
           .rename(columns={"median": "bm_med", "lo80": "bm_lo80",
                            "hi80": "bm_hi80"}))
    d = d.merge(_mb, on="year", how="left")
    hist_ref = d[d["year"].between(1951, 1965)]["bm_med"].mean()

    fig = plt.figure(figsize=(W_IN, H_IN), dpi=DPI)
    gs = gridspec.GridSpec(2, 1, height_ratios=[1.0, 1.35], hspace=0.10,
                           left=0.085, right=0.965, top=0.95, bottom=0.115)
    axp = fig.add_subplot(gs[0])
    axb = fig.add_subplot(gs[1], sharex=axp)

    # ── top: PDO index (cool/productive = marine, warm = rust) ──
    pdo = d["pdo"].values
    yrs = d["year"].values
    colors = np.where(pdo < 0, MARINE, RUST)
    axp.bar(yrs, pdo, color=colors, width=0.9, zorder=3)
    axp.axhline(0, color=INK_SOFT, lw=1.0)
    axp.axvspan(2014, 2016, color=AMBER, alpha=0.16, zorder=0)
    # "Blob" label moved INTO the gold band — rotated 90°, white text
    axp.text(2015, 0, "2014–16 'Blob'", color="white",
             fontsize=16, ha="center", va="center", style="italic",
             fontweight="bold", rotation=90, zorder=5)
    axp.text(yrs.min() + 0.5, np.nanmin(pdo) * 0.92,
             "cool · productive", color=MARINE, fontsize=16, ha="left",
             va="bottom", style="italic", fontweight="bold")
    axp.text(yrs.min() + 0.5, np.nanmax(pdo) * 0.92, "warm", color=RUST,
             fontsize=16, ha="left", va="top", style="italic",
             fontweight="bold")
    axp.set_ylabel("PDO index", color=INK_SOFT, fontsize=18, labelpad=10)
    # PDO y-tick labels bumped from ~15pt to 18pt for legibility from back row
    axp.tick_params(labelsize=18)
    axp.tick_params(axis="x", labelbottom=False)
    for s in ("top", "right", "bottom"):
        axp.spines[s].set_visible(False)
    axp.spines["left"].set_color(INK_SOFT)

    # ── bottom: herring biomass (focal_9 m1, median + 80% CI) + closures ──
    bm = d.dropna(subset=["bm_med"])
    # Cap just above the 1950s peak; the 80% CI balloons off-chart after
    # ~2023 (terminal years weakly constrained) — that clipping is the
    # honest signal that the recent rise is uncertainty, not recovery.
    bmax = 115000.0
    axb.fill_between(bm["year"], bm["bm_lo80"], bm["bm_hi80"], color=RUST,
                     alpha=0.15, linewidth=0, zorder=2)
    axb.plot(bm["year"], bm["bm_med"], color=RUST, lw=3.2, zorder=5)
    axb.axhline(hist_ref, color=INK_SOFT, lw=1.5, ls=(0, (5, 4)), alpha=0.85,
                zorder=3)
    axb.text(yrs.min() + 0.5, hist_ref + bmax * 0.025,
             f"historic level  ·  m1 1951–65 mean ≈ {hist_ref/1000:.0f} kt",
             color=INK_SOFT, fontsize=13, style="italic", ha="left",
             va="bottom")
    axb.axvspan(2014, 2016, color=AMBER, alpha=0.16, zorder=0)
    for cx, lab in [(1968, "1968 closure"), (1994, "1994 closure")]:
        axb.axvline(cx, color=AMBER, lw=2.2, ls=(0, (6, 4)), alpha=0.9,
                    zorder=4)
        axb.text(cx, bmax * 0.965, lab, color=AMBER, fontsize=15,
                 ha="center", va="top", fontweight="bold")
    # callouts promoted to pure white 20pt (two lines max each, same text)
    axb.annotate("cool years drove the\nrapid 1960s rebound", xy=(1973, 28000),
                 xytext=(1974, bmax * 0.58), color="white", fontsize=20,
                 style="italic", ha="left", linespacing=1.05,
                 arrowprops=dict(arrowstyle="-|>", color=INK_SOFT, lw=1.8))
    axb.annotate("repeated cool, productive years — and\nthe Blob passed: a partial uptick, "
                 "still below historic", xy=(2016, 24000),
                 xytext=(1998, bmax * 0.585), color="white", fontsize=20,
                 style="italic", ha="left", linespacing=1.08,
                 arrowprops=dict(arrowstyle="-|>", color=INK_SOFT, lw=1.8))
    axb.set_xlim(yrs.min(), yrs.max())
    axb.set_ylim(0, bmax)
    axb.set_ylabel("Estimated biomass (tonnes)", color=INK_SOFT,
                   fontsize=18, labelpad=10)
    axb.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{int(v):,}"))
    axb.tick_params(labelsize=15)
    axb.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.5)
    for s in ("top", "right"):
        axb.spines[s].set_visible(False)
    axb.spines["left"].set_color(INK_SOFT)
    axb.spines["bottom"].set_color(INK_SOFT)

    fig.savefig(OUT / "06_climate_pdo.png", dpi=DPI, bbox_inches=None,
                pad_inches=0)
    plt.close(fig)
    print("wrote 06_climate_pdo.png")


def s7_two_scales():
    """S7 — the two scales. ONE 80% CI halo per series, two big direct
    labels (no legend box), one compact HCR label, one short headline.
    Updated Stier et al. 2020 method — scale-mismatch result, not
    m1_stier_11 (provenance baked by preprocess_figures.py)."""
    d4 = pd.read_csv(DIAG / "stier2020_updated_fig4_fishing.csv")
    arch = d4[d4["scale"] == "Archipelago-wide"].sort_values("year")
    fish = d4[d4["scale"] == "Fished sections only"].sort_values("year")
    arch_med = round(arch["median"].median() * 100)
    fish_peak = round(fish["median"].max() * 100)
    fish_hi = round(fish["hi95"].max() * 100)

    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    fig.subplots_adjust(left=0.085, right=0.965, top=0.93, bottom=0.115)

    # one halo per series (80% CI only)
    ax.fill_between(fish["year"], fish["lo80"], fish["hi80"], color=RUST,
                    alpha=0.18, linewidth=0)
    ax.fill_between(arch["year"], arch["lo80"], arch["hi80"], color=MARINE,
                    alpha=0.20, linewidth=0)
    ax.plot(fish["year"], fish["median"], color=RUST, lw=3.4, zorder=5)
    ax.plot(arch["year"], arch["median"], color=MARINE, lw=2.8, zorder=5)

    # DFO harvest-rate rule — stepped, one compact label in clear space
    ax.plot([1983, 2017], [0.20, 0.20], color=AMBER, lw=2.0,
            ls=(0, (6, 4)), zorder=4)
    ax.plot([2017, 2017], [0.20, 0.10], color=AMBER, lw=1.4,
            ls=(0, (2, 3)), zorder=4)
    ax.plot([2017, 2025], [0.10, 0.10], color=AMBER, lw=2.0,
            ls=(0, (6, 4)), zorder=4)
    ax.text(2024.5, 0.235, "DFO harvest-rate rule\n20% (1983–2017), then 10%",
            color=AMBER, fontsize=16, ha="right", va="bottom",
            fontweight="bold", linespacing=1.05)

    # direct series labels (no legend)
    ax.text(1971, 0.55, "Fished sections only\n(what fished coves experience)",
            color=RUST, fontsize=20, fontweight="bold", ha="left",
            va="bottom", linespacing=1.0)
    ax.text(1956, 0.085, "Archipelago-wide (the managed rate)",
            color=MARINE, fontsize=18, fontweight="bold", ha="left",
            va="bottom")

    # short headline in the clear post-2000 upper-right
    ax.text(0.985, 0.95,
            f"Coves fished to ~{fish_peak}%  (up to ~{fish_hi}%)\n"
            f"while the archipelago averaged ~{arch_med}%",
            transform=ax.transAxes, ha="right", va="top", fontsize=20,
            fontweight="bold", color=INK, style="italic", linespacing=1.1)

    ax.set_xlim(1951, 2025)
    ax.set_ylim(0, 0.78)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, _: f"{v*100:.0f}%"))
    ax.set_yticks(np.arange(0, 0.71, 0.1))
    ax.set_ylabel("Proportion of biomass caught  (F)", color=INK_SOFT,
                  fontsize=19, labelpad=10)
    ax.tick_params(labelsize=16)
    ax.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.5)
    for s in ("top", "right"):
        ax.spines[s].set_visible(False)
    ax.spines["left"].set_color(INK_SOFT)
    ax.spines["bottom"].set_color(INK_SOFT)

    fig.savefig(OUT / "07_two_scales.png", dpi=DPI, bbox_inches=None,
                pad_inches=0)
    plt.close(fig)
    print("wrote 07_two_scales.png")


def s8b_subpop_portfolio():
    """S8b — THE PORTFOLIO, raw: each modelled herring subpopulation's
    biomass through time. Sets up the synchrony slide that follows. Each
    section is scaled to its own 1951–90 mean (log y) so all 11 are visible
    and the asynchrony reads: coves used to peak and trough on their own
    schedules — that spread IS the portfolio. UNFRAMED content figure (the
    chrome bake adds the title/takeaway)."""
    d = pd.read_csv(DIAG / "m1_stier_11_section_biomass_by_year.csv")
    d = d.sort_values(["site", "year"])
    base = (d[(d.year >= 1951) & (d.year <= 1990)]
            .groupby("site")["median"].mean())
    d["rel"] = d["median"] / d["site"].map(base)

    OK = ["#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2",
          "#D55E00", "#CC79A7", "#8AA074", "#B685A8"]

    fig, ax = plt.subplots(figsize=(W_IN, H_IN), dpi=DPI)
    # right margin pulled in to 0.91 so x-axis terminates cleanly inside panel
    fig.subplots_adjust(left=0.072, right=0.910, top=0.93, bottom=0.135)

    fi = 0
    for site, gdf in d.groupby("site"):
        sparse = gdf["focal_status"].iloc[0] != "focal_9"
        if sparse:
            ax.plot(gdf.year, gdf.rel, color="#6f6860", lw=1.4, alpha=0.55,
                    ls=(0, (4, 3)), zorder=2)
        else:
            # alpha reduced 0.85 → 0.60 so white aggregate pops
            ax.plot(gdf.year, gdf.rel, color=OK[fi % len(OK)], lw=2.0,
                    alpha=0.60, zorder=3)
            fi += 1

    # cross-section median trajectory (the aggregate) — anchor line
    agg = d.groupby("year")["rel"].median()
    ax.plot(agg.index, agg.values, color=INK, lw=4.0, alpha=0.95, zorder=5)

    # In-panel annotation replaces the truncated right-edge label
    ax.text(1955, 9.5,
            "— white: across-cove median\n— — dashed: ±IQR",
            color=INK, fontsize=16, fontweight="bold",
            va="top", ha="left", linespacing=1.4, zorder=6)

    for cx, lab in [(1968, "1968 collapse"), (1994, "1994 closure")]:
        ax.axvline(cx, color=AMBER, lw=2.2, ls=(0, (6, 4)), alpha=0.85,
                   zorder=4)
        ax.text(cx, 14, f" {lab}", color=AMBER,
                fontsize=16, fontweight="bold", va="top")

    ax.set_yscale("log")
    ax.set_xlim(1951, 2025)
    ax.set_ylim(0.06, 18)
    ax.set_ylabel("biomass relative to each subpopulation's 1951–90 mean",
                  color=INK_SOFT, fontsize=18, labelpad=10)
    ax.yaxis.set_major_formatter(FuncFormatter(
        lambda v, _: ("%g×" % v) if v in (0.1, 1, 10) else ""))
    ax.set_yticks([0.1, 1, 10])
    # y-tick labels bumped from 15 → 20 pt for legibility on 4K slide
    ax.tick_params(labelsize=20)
    ax.grid(True, axis="y", color=GRID, lw=0.8, alpha=0.45)
    ax.axhline(1.0, color=INK_SOFT, lw=1.0, alpha=0.5, zorder=1)
    for s in ("top", "right"):
        ax.spines[s].set_visible(False)
    ax.spines["left"].set_color(INK_SOFT)
    ax.spines["bottom"].set_color(INK_SOFT)

    fig.savefig(OUT / "08b_subpop_portfolio.png", dpi=DPI, bbox_inches=None,
                pad_inches=0)
    plt.close(fig)
    print("wrote 08b_subpop_portfolio.png")


if __name__ == "__main__":
    s5_two_collapses()
    s6_pdo_recovery()
    s7_two_scales()
    s8_diverging_growth()
    s8b_subpop_portfolio()
    s9_portfolio_before_after()
    s10_predator_demand()
    s10b_predator_pit()
    s12_four_clocks_timeline()
    print("done.")
